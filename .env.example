# Copia este archivo a .env en la raíz del repo. No subas el .env a Git.

# MongoDB Atlas. Base: utm_desk
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.example.mongodb.net/
MONGODB_DB=utm_desk

# Upstash Redis (REST). El folio usa INCR.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firma del JWT. Cámbiala antes de publicar.
JWT_SECRET=cambia-esto-en-local
JWT_EXPIRES_IN=8h

# Contraseña de las cinco cuentas que crea db/seed.mjs
SEED_PASSWORD=utmdesk123

API_PORT=3000
CORS_ORIGIN=http://localhost:5173
